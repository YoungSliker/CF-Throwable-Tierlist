.container { padding: 24rpx 20rpx; }
.title {
  text-align: center; font-size: 44rpx; font-weight: 800;
  background: linear-gradient(135deg, #f0b429, #e040fb);
  -webkit-background-clip: text; background-clip: text; color: transparent;
  margin-bottom: 8rpx;
}
.subtitle { text-align: center; color: #7d8590; font-size: 22rpx; margin-bottom: 24rpx; }

.search-bar { display: flex; gap: 16rpx; align-items: center; margin-bottom: 16rpx; }
.search-input {
  flex: 1; padding: 16rpx 24rpx; border-radius: 16rpx;
  background: #161b22; border: 1rpx solid #30363d; color: #e6edf3;
  font-size: 28rpx;
}
.next-btn {
  padding: 16rpx 28rpx; border-radius: 16rpx;
  background: linear-gradient(135deg, #f0b429, #d97706); color: #000;
  font-size: 26rpx; font-weight: 700; white-space: nowrap;
}
.match-counter { text-align: center; color: #7d8590; font-size: 22rpx; margin-bottom: 16rpx; }

.tabs { display: flex; gap: 12rpx; justify-content: center; margin-bottom: 24rpx; flex-wrap: wrap; }
.tab {
  padding: 14rpx 36rpx; border-radius: 14rpx; background: #161b22; color: #7d8590;
  font-size: 28rpx; font-weight: 600; border: 1rpx solid #30363d;
}
.tab.active { background: linear-gradient(135deg, #1f6feb, #388bfd); color: #fff; border-color: #388bfd; }
.tab.flash { animation: tabFlash 0.6s ease; }
@keyframes tabFlash {
  0% { box-shadow: 0 0 0 0 rgba(240,180,41,.8); }
  100% { box-shadow: 0 0 0 30rpx rgba(240,180,41,0); }
}

.tier-row {
  display: flex; align-items: flex-start; gap: 16rpx;
  padding: 20rpx; border-radius: 16rpx; margin-bottom: 12rpx;
  background: #161b22; border: 1rpx solid #30363d;
}
.tier-row.dimmed { opacity: 0.2; }
.tier-badge {
  flex-shrink: 0; width: 80rpx; height: 80rpx; border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; font-weight: 900; color: #000;
}
.T0 { background: linear-gradient(135deg, #ffd700, #ffaa00); }
.T1 { background: linear-gradient(135deg, #a855f7, #7c3aed); color: #fff; }
.T2 { background: linear-gradient(135deg, #3b82f6, #2563eb); color: #fff; }
.T3 { background: linear-gradient(135deg, #22c55e, #16a34a); color: #fff; }
.T4 { background: linear-gradient(135deg, #f97316, #ea580c); color: #fff; }
.T5 { background: linear-gradient(135deg, #64748b, #475569); color: #fff; }
.T6 { background: linear-gradient(135deg, #14b8a6, #0d9488); color: #fff; }
.T7 { background: linear-gradient(135deg, #6b7280, #4b5563); color: #fff; }

.tier-body { flex: 1; min-width: 0; }
.icons-grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx;
}
.icon-wrap {
  position: relative;
  width: 100%; aspect-ratio: 1; background: #21262d; border-radius: 12rpx;
  display: flex; align-items: center; justify-content: center; overflow: visible;
}
.icon { width: 100%; height: 100%; }
.no-icon-text { color: #484f58; font-size: 20rpx; text-align: center; padding: 8rpx; }
.icon-wrap.match { box-shadow: 0 0 16rpx rgba(31,111,235,.8); }
.icon-wrap.current { box-shadow: 0 0 24rpx rgba(240,180,41,1); background: #2a2510; }

.names-row {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx 8rpx;
  margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #30363d;
}
.name-tag {
  padding: 6rpx 10rpx; border-radius: 8rpx; background: #21262d;
  font-size: 20rpx; color: #c9d1d9; text-align: center;
}
.name-tag.match { background: #1f6feb; color: #fff; }
.name-tag.current { background: #f0b429; color: #000; font-weight: 700; }

/* 点击图标弹出的名称气泡，贴在图标上方 */
.cell-tip {
  position: absolute; bottom: 100%; left: 50%; transform: translateX(-50%);
  background: #1f6feb; color: #fff; padding: 10rpx 16rpx;
  border-radius: 10rpx; font-size: 22rpx;
  z-index: 50; margin-bottom: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(31,111,235,.5);
  max-width: 400rpx; white-space: normal; text-align: center;
}
.tip-name { font-weight: 700; margin-bottom: 4rpx; }
.tip-desc { font-size: 20rpx; opacity: .9; line-height: 1.4; }
.cell-tip::after {
  content: ''; position: absolute; top: 100%; left: 50%; transform: translateX(-50%);
  border: 8rpx solid transparent; border-top-color: #1f6feb;
}

.empty { text-align: center; padding: 120rpx 0; color: #7d8590; }
.empty-text { font-size: 28rpx; }
